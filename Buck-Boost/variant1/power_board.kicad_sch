	(text "L = (Vin-Vout)*Vout/(Fs*dIout*Vin)\n  = (60-12)*12/(500000*30*60)\n  ~ 1uH\n\nCout = dIout^2*L/(2*Vout*dVout)\n     = 30^2*0.000001/(2*12*0.5)\n     = 75uF"
